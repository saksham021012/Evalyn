  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "groq-sdk": "^0.37.0",
    "pdfkit": "^0.17.2",
    "react-hot-toast": "^2.6.0"
  }
}
